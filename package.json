{
  "name": "@zubricks/payload-admin-ui-themes",
  "version": "0.1.0",
  "description": "Installable, user-selectable Admin UI themes for Payload",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./themes/stock": {
      "types": "./dist/themes/stock.d.ts",
      "import": "./dist/themes/stock.js",
      "default": "./dist/themes/stock.js"
    },
    "./themes/light-cream": {
      "types": "./dist/themes/lightCream/index.d.ts",
      "import": "./dist/themes/lightCream/index.js",
      "default": "./dist/themes/lightCream/index.js"
    },
    "./themes/light-cream/client": {
      "types": "./dist/themes/lightCream/client.d.ts",
      "import": "./dist/themes/lightCream/client.js",
      "default": "./dist/themes/lightCream/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && copyfiles -u 1 \"src/**/*.css\" dist",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^4.0.0",
    "payload": "^4.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "4.0.0-canary.37",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "4.5.2",
    "copyfiles": "2.4.1",
    "jsdom": "28.0.0",
    "payload": "4.0.0-canary.37",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "6.0.1",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
